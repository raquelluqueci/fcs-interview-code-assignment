# =============================================================================
# .gitignore — FCS interview submission
# EN: Keep the repo reviewer-clean (no AI tool state, no build outputs, no logs).
# PT: Manter o repo limpo para avaliacao (sem estado de ferramentas de IA, builds ou logs).
#
# EN: Demo passwords in application.properties MAY be committed (evaluation project).
# PT: Senhas de demo em application.properties PODEM ir no git (projeto de avaliacao).
# =============================================================================

# -----------------------------------------------------------------------------
# AI / LLM / agent tooling state  |  Estado de ferramentas de IA / agentes
# -----------------------------------------------------------------------------
.omc/
.omx/
.claude/
.claude-mem/
.cursor/
.codex/
.continue/
.aider*
.grok/
.gemini/
.windsurf/
.tabnine/
.specstory/
.anthropic/
.openai/
.opencode/
.crush/
.vibe/
.remember/
.agent/
.agents/
.copilot/
.github/copilot-instructions.local.md
.llm/
.langchain/
.langsmith/
.auto-memory/
.factory/
.kilocode/
.roo/
.trae/
.zed/
.augment/
.void/
.cline/
.pearai/
.piece/
.repomix/
.serena/
.swarm/
.ultrawork/
.ralph/
.ralplan/
**/.omc/**
**/.claude/**
**/.cursor/**
**/.codex/**
**/.grok/**
**/.continue/**
**/.remember/**
**/.allen-key/**
**/*-transcript*
**/*agent-transcript*
**/.stop-transcript*
*.session.json
*.chat.json
.allen-key/
allen-key.local.*

# -----------------------------------------------------------------------------
# Build outputs  |  Saidas de build
# -----------------------------------------------------------------------------
**/target/
target/
**/build/
build/
**/out/
out/
**/dist/
dist/
**/bin/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/coverage/
coverage/
**/htmlcov/
**/.nyc_output/
**/*.tsbuildinfo
**/*.class
*.class
**/*.jar
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
**/*.war
**/*.ear
**/*.nar
**/*.zip
**/*.tar.gz
**/*.rar
**/.quarkus/
**/quarkus.log
**/quarkus-app/

# -----------------------------------------------------------------------------
# Dependencies  |  Dependencias
# -----------------------------------------------------------------------------
**/node_modules/
node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/.npm/
**/.yarn/cache
**/.yarn/unplugged
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/.pnp.*
**/bower_components/
**/vendor/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.gradle/
**/.mvn/timing.properties
**/dependency-reduced-pom.xml
**/mvn-settings-local.xml
mvn-settings-local.xml
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/release.properties
release.properties

# -----------------------------------------------------------------------------
# Logs and temp  |  Logs e temporarios
# -----------------------------------------------------------------------------
**/logs/
logs/
**/*.log
*.log
**/*.log.*
**/tmp/
**/temp/
**/*.tmp
**/*.temp
**/*.bak
**/*.bak-*
**/*.orig
**/*.rej
**/*~
**/*.swp
**/*.swo
**/.hs_err_pid*
**/replay_pid*
**/core.*

# -----------------------------------------------------------------------------
# Local env overrides  |  Overrides de ambiente local
# .env.example stays tracked  |  .env.example permanece versionado
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# IDE / editors
# -----------------------------------------------------------------------------
.idea/
**/*.iml
**/*.ipr
**/*.iws
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.project
.classpath
.settings/
.factorypath
.apt_generated/
.nb-gradle/
nb-configuration.xml
*.sublime-project
*.sublime-workspace
.history/

# -----------------------------------------------------------------------------
# OS junk  |  Lixo do SO
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Observability local-only  |  Observabilidade so local
# -----------------------------------------------------------------------------
observability/.data/
observability/evidence/
**/docker-data/
**/*.pid
scripts/install-local-odin.sh
observability/nginx/

# Patch leftovers
*.patch
*.diff
.patches/

# Local analysis reports (never publish)
/ANALISE_ADICIONAL_CASE_STUDY_LOCAL.md
