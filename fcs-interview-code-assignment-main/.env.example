# FCS Interview — copy to .env (never commit .env)
# Quarkus maps: quarkus.foo.bar-baz → QUARKUS_FOO_BAR_BAZ
# Standard OTEL_* variables are honored by quarkus-opentelemetry.

# --- HTTP ---
QUARKUS_HTTP_PORT=8080
QUARKUS_HTTP_HOST=0.0.0.0

# Which module (documentation only)
# FCS_MODULE=senior   # or architect

# --- Datasource (profile=prod or Dev Services disabled) ---
QUARKUS_DATASOURCE_USERNAME=quarkus_test
QUARKUS_DATASOURCE_PASSWORD=quarkus_test
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:15432/quarkus_test

# --- Local observability stack ---
GRAFANA_ADMIN_PASSWORD=change-me-before-use
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Optional external datasource (disables Dev Services) ---
# QUARKUS_DATASOURCE_DB_KIND=postgresql
# QUARKUS_DATASOURCE_USERNAME=quarkus_test
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/fcs_fulfilment
# QUARKUS_DATASOURCE_DEVSERVICES_ENABLED=false

# --- Logging ---
QUARKUS_HIBERNATE_ORM_LOG_SQL=true
